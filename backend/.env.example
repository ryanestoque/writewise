SUPABASE_URL=your_supabase_dev_url
# Public API key used only with the caller's verified JWT for gradebook RLS reads.
SUPABASE_ANON_KEY=your_supabase_dev_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_dev_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_DB_URL=your_supabase_dev_db_url
MODEL_STORAGE_BUCKET=model-artifacts
MODEL_ARTIFACT_PATH=
HTR_MODEL_ARTIFACT_PATH=
SCORING_ENGINE=manual
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=dev

# Optional classroom email delivery; configure a verified sender before enabling.
EMAIL_DISPATCH_ENABLED=false
EMAIL_DISPATCH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=
